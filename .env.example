NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Vercel AI Gateway powers /api/chat.
# Required for static-key auth. Add this to .env.local and to Vercel Project
# Settings -> Environment Variables for Production, Preview, and Development.
AI_GATEWAY_API_KEY="your-ai-gateway-api-key"

# Optional OIDC auth alternative:
# `vercel link && vercel env pull .env.local` writes VERCEL_OIDC_TOKEN.
# Local OIDC tokens expire; Vercel deployments refresh OIDC automatically.

# Optional: override the Vercel AI Gateway model used by /api/chat.
AI_MODEL="openai/gpt-5.4"
